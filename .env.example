X_CLIENT_ID=your_client_id
X_CLIENT_SECRET=your_client_secret
# Must exactly match the callback registered in X Developer Console
X_REDIRECT_URI=http://127.0.0.1:3000/oauth/callback
PORT=3000
# 授权成功后自动打开该账号的独立浏览器并执行一轮；设为 false 可关闭
X_AUTO_START_LOOP=true
# 可选：Chrome for Testing 可执行文件的绝对路径；不填则使用 Playwright 安装的浏览器
# X_BROWSER_EXECUTABLE=
# 可选：CommentCrate 已解压的扩展目录；不填时尝试查找 Chrome for Testing 的已有安装
# X_COMMENTCRATE_EXTENSION_PATH=
# 多个账号均已授权时，填写本轮要使用的授权账号数字 ID
# X_FOLLOW_ACCOUNT_ID=
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=your_model
