X_CLIENT_ID=your_client_id
X_CLIENT_SECRET=your_client_secret
# Must exactly match the callback registered in X Developer Console
X_REDIRECT_URI=http://127.0.0.1:3000/oauth/callback
PORT=3000
# 镜像发帖的轮询间隔（毫秒），默认 60000
# MIRROR_INTERVAL_MS=60000
# 镜像发帖之间的随机间隔（毫秒），默认 5000–10000
# MIRROR_POST_GAP_MIN_MS=5000
# MIRROR_POST_GAP_MAX_MS=10000
# 镜像轮询额外随机抖动（毫秒），默认轮询间隔的 20%
# MIRROR_POLL_JITTER_MS=12000
# 镜像 API 请求前的随机抖动上限（毫秒），默认 800
# MIRROR_REQUEST_JITTER_MS=800

# 未指定 --target 时自动搜索时尚博主的规则
# CLONE_TARGET_MIN_REPLIES=50
# CLONE_TARGET_MIN_FOLLOWERS=1000
# CLONE_TARGET_REQUIRED_POSTS=2
# CLONE_TARGET_MAX_CANDIDATES=40
# FASHION_SEARCH_QUERIES=fashion,fashion blogger,fashion influencer,ootd,street style

# 新帖镜像成功后，延迟多久执行回复爬取（默认 5 小时）
# MIRROR_REPLY_DELAY_MS=18000000
# 回复爬取调度器检查间隔（默认 60 秒）
# MIRROR_REPLY_SCHEDULER_MS=60000
# 回复爬取失败重试间隔（默认 10 分钟）
# MIRROR_REPLY_RETRY_MS=600000
# 延迟任务自动确认关注；默认 false，会在终端提示 y/n
# MIRROR_REPLY_AUTO_YES=false
# 旧版后台模式：授权后自动打开账号浏览器；前台 loop 命令建议设为 false
X_AUTO_START_LOOP=false
# 可选：正式版 Google Chrome 可执行文件的绝对路径；默认使用 /Applications/Google Chrome.app
# X_BROWSER_EXECUTABLE=
# 可选：自定义 X cookie 文件路径；默认 .data/cookies/<账号数字ID>.json
# X_COOKIE_FILE=
# 多个账号均已授权时，填写本轮要使用的授权账号数字 ID
# X_FOLLOW_ACCOUNT_ID=
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=your_model
# 收到回关事件后自动用 LLM 生成欢迎私信（首句 hello）；需要重新授权并授予 dm.read/dm.write，
# 且 X 应用具备 Direct Message 访问权限。未配置以上三项时跳过私信回复。
# 可选：exporter24 扩展 ID；未安装时自动回退到主页读取
# X_EXPORTER24_EXTENSION_ID=ebcejikneofoobengkjlojmbohgjacne
# 可选：插件模板目录；新账号首次运行时自动复制一份
# X_PROFILE_TEMPLATE=.data/profile-template
# 可选：生成模板时读取的 Chrome 用户资料目录
# X_PROFILE_TEMPLATE_SOURCE=/path/to/Google/Chrome
