X_CLIENT_ID=your_client_id
X_CLIENT_SECRET=your_client_secret
# Must exactly match the callback registered in X Developer Console
X_REDIRECT_URI=http://127.0.0.1:3000/oauth/callback
PORT=3000
# 镜像发帖的轮询间隔（毫秒），默认 60000
# MIRROR_INTERVAL_MS=60000
# 旧版后台模式：授权后自动打开账号浏览器；前台 loop 命令建议设为 false
X_AUTO_START_LOOP=false
# 可选：正式版 Google Chrome 可执行文件的绝对路径；默认使用 /Applications/Google Chrome.app
# X_BROWSER_EXECUTABLE=
# 多个账号均已授权时，填写本轮要使用的授权账号数字 ID
# X_FOLLOW_ACCOUNT_ID=
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=your_model
