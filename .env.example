# API / OAuth 连接信息；运行参数见 config.example.toml
X_CLIENT_ID=your_client_id
X_CLIENT_SECRET=your_client_secret
# 必须与开发者后台及 config.toml 的服务端口一致
X_REDIRECT_URI=http://127.0.0.1:3000/oauth/callback
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=your_model
# X_ACTIVITY_APP_BEARER_TOKEN=
